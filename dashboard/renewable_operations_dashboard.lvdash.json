{
  "datasets": [
    {
      "name": "a1000001",
      "displayName": "Renewable operations semantic data",
      "queryLines": [
        "SELECT\n",
        "  date,\n",
        "  month,\n",
        "  asset,\n",
        "  technology,\n",
        "  region,\n",
        "  operational_owner,\n",
        "  incident_severity,\n",
        "  actual_generation_mwh,\n",
        "  forecast_generation_mwh,\n",
        "  generation_variance_mwh,\n",
        "  generation_variance_pct,\n",
        "  availability_pct,\n",
        "  capacity_factor_pct,\n",
        "  operating_cost_eur,\n",
        "  cost_per_mwh_eur,\n",
        "  avoided_co2_tonnes,\n",
        "  incident_count,\n",
        "  downtime_hours\n",
        "FROM workspace.renewable_operations_demo.gg_renewable_operations_semantic\n"
      ]
    },
    {
      "name": "a1000002",
      "displayName": "Actual versus forecast trend",
      "queryLines": [
        "SELECT date, region, technology, asset, 'Real' AS series, actual_generation_mwh AS generation_mwh\n",
        "FROM workspace.renewable_operations_demo.gg_renewable_operations_semantic\n",
        "UNION ALL\n",
        "SELECT date, region, technology, asset, 'Prevista' AS series, forecast_generation_mwh AS generation_mwh\n",
        "FROM workspace.renewable_operations_demo.gg_renewable_operations_semantic\n"
      ]
    }
  ],
